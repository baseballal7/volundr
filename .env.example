# copy to .volundr.env next to docker-compose.yml (chmod 600) — never commit the real one
# Battle.net API client: https://develop.battle.net/access/clients  (client credentials; no user login flow needed for level 10+ characters)
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
# ForeverDB.net API key: https://foreverdb.net/developers (request access, then create a key; free tier 5k/day, 30/min)
FOREVERDB_API_KEY=
# optional: pin the static namespace if the plain alias ever 403s again (e.g. static-1.60.1_70399-forever-us)
#BNET_STATIC_NS=
